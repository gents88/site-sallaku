{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "static-assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/i18n/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "blog-list-api",
      "urls": [
        "/api/v1/blog/posts",
        "/api/v1/blog/posts?*",
        "https://portfolio-backend-production-e76d.up.railway.app/api/v1/blog/posts",
        "https://portfolio-backend-production-e76d.up.railway.app/api/v1/blog/posts?*"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 30,
        "maxAge": "7d",
        "timeout": "4s"
      }
    },
    {
      "name": "blog-detail-api",
      "urls": [
        "/api/v1/blog/posts/*",
        "https://portfolio-backend-production-e76d.up.railway.app/api/v1/blog/posts/*"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "30d",
        "timeout": "4s"
      }
    },
    {
      "name": "static-api",
      "urls": [
        "/api/v1/projects*",
        "/api/v1/projects/**",
        "/api/v1/about*",
        "/api/v1/experiences*",
        "https://portfolio-backend-production-e76d.up.railway.app/api/v1/projects",
        "https://portfolio-backend-production-e76d.up.railway.app/api/v1/projects/**",
        "https://portfolio-backend-production-e76d.up.railway.app/api/v1/about*",
        "https://portfolio-backend-production-e76d.up.railway.app/api/v1/experiences*"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 30,
        "maxAge": "7d",
        "timeout": "4s"
      }
    },
    {
      "name": "pdf-search-covers",
      "urls": [
        "https://archive.org/services/img/**",
        "https://www.gutenberg.org/cache/epub/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "3s"
      }
    }
  ]
}
