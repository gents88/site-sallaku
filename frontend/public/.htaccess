<IfModule mod_dir.c>
  # Prevent Apache's automatic trailing-slash redirect for directory
  # requests (e.g. /projects -> /projects/) — it fires before mod_rewrite's
  # own directory handling below and would 301 every prerendered route
  # away from its own canonical (no-trailing-slash) URL.
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Backend NestJS (pm2 su 127.0.0.1:3000, vedi docs/guides/deploy-plesk.md)
  # Apache fa da reverse proxy per le API e per il WebSocket della chat live
  # (socket.io): niente nginx su questo server e niente accesso al pannello
  # admin, quindi il proxy vive qui. Prima di ogni altra regola, così le API non
  # finiscono mai nei .br/.gz o nel fallback SPA.
  # La query string viene aggiunta da Apache: metterla nella sostituzione
  # (es. da THE_REQUEST) fa scattare il 403 della fix CVE-2023-25690.
  RewriteCond %{HTTP:Upgrade} =websocket [NC]
  RewriteRule ^socket\.io/(.*)$ ws://127.0.0.1:3000/socket.io/$1 [P,L]
  RewriteRule ^(api|socket\.io)/(.*)$ http://127.0.0.1:3000/$1/$2 [P,L]

  # ── Pre-compressed assets ────────────────────────────────────
  # This server has no mod_brotli (requesting `Accept-Encoding: br` alone
  # returns an uncompressed response), and a FileZilla deploy can't enable
  # server modules. scripts/precompress.js therefore emits <file>.br and
  # <file>.gz at build time — at quality 11 / level 9, which would be far too
  # slow to run per request but is free once on the build machine — and these
  # rules hand them out when the client advertises support.
  # Must stay above the SPA fallback rules below, which end in [L].
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}\.br -f
  RewriteRule ^(.+)$ $1.br [L]

  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}\.gz -f
  RewriteRule ^(.+)$ $1.gz [L]

  # AI/PDF tool pages moved from /dashboard/* to /lab/* (2026-08) — permanent
  # redirects so existing bookmarks/search results keep working instead of
  # 404ing, and so the old URLs' indexing transfers to the new ones instead
  # of being lost. Must come before the SPA fallback rules below.
  RewriteRule ^dashboard/tools/?$ /lab [R=301,L]
  RewriteRule ^dashboard/(pdf-summary|ai-formatter|pdf-translate|ai-ppt|convert|pdf-editor|viewer|editor|ocr|scanner)(/.*)?$ /lab/$1$2 [R=301,L]

  # Articoli accorpati il 2026-11 (contenuti sovrapposti): ogni URL, in tutte le
  # lingue, porta all'articolo che ne ha assorbito il contenuto. Prima delle regole
  # sui file prerenderizzati, così vincono anche se la vecchia cartella è ancora sul server.
  RewriteRule ^blog/colloquio-di-lavoro-per-front-end-developer-domande-risposte-e-consigli-pratici/?$ /blog/25-domande-colloquio-frontend-angular-developer-junior-lead [R=301,L]
  RewriteRule ^en/blog/front-end-developer-job-interview-questions-answers-and-practical-tips/?$ /en/blog/25-frontend-angular-developer-interview-questions-from-junior-to-lead-with-answers [R=301,L]
  RewriteRule ^sq/blog/intervista-pune-per-front-end-developer-pyetje-pergjigje-dhe-keshilla-praktike/?$ /sq/blog/25-pyetje-intervistash-per-frontend-angular-developer-nga-junior-te-lead-me-pergjigje [R=301,L]
  RewriteRule ^pt/blog/entrevista-de-emprego-para-front-end-developer-perguntas-respostas-e-dicas-praticas/?$ /pt/blog/25-perguntas-de-entrevista-para-frontend-angular-developer-de-junior-a-lead-com-respostas [R=301,L]
  RewriteRule ^es/blog/entrevista-de-trabajo-para-front-end-developer-preguntas-respuestas-y-consejos-practicos/?$ /es/blog/25-preguntas-de-entrevista-para-frontend-angular-developer-de-junior-a-lead-con-respuestas [R=301,L]
  RewriteRule ^fr/blog/entretien-dembauche-pour-front-end-developer-questions-reponses-et-conseils-pratiques/?$ /fr/blog/25-questions-dentretien-pour-frontend-angular-developer-de-junior-a-lead-avec-reponses [R=301,L]
  RewriteRule ^de/blog/vorstellungsgesprach-als-front-end-developer-fragen-antworten-und-praktische-tipps/?$ /de/blog/25-vorstellungsgesprach-fragen-fur-frontend-angular-developer-von-junior-bis-lead-mit-antworten [R=301,L]
  RewriteRule ^blog/best-practice-sicurezza-performance-web-combinate/?$ /blog/cookie-cache-websocket [R=301,L]
  RewriteRule ^en/blog/combined-best-practices-for-modern-web-apps-security-caching-and-websocket/?$ /en/blog/cookies-cache-and-websockets-a-practical-guide-for-developers [R=301,L]
  RewriteRule ^sq/blog/praktikat-me-te-mira-te-kombinuara-per-aplikacionet-moderne-te-uebit-siguria-cache-dhe-websockets/?$ /sq/blog/cookies-cache-dhe-websockets-nje-udhezues-praktik-per-zhvilluesit [R=301,L]
  RewriteRule ^pt/blog/boas-praticas-combinadas-para-apps-web-modernas-seguranca-cache-e-websocket/?$ /pt/blog/cookies-cache-e-websockets-um-guia-pratico-para-desenvolvedores [R=301,L]
  RewriteRule ^es/blog/buenas-practicas-combinadas-para-apps-web-modernas-seguridad-cache-y-websocket/?$ /es/blog/cookies-cache-y-websockets-una-guia-practica-para-desarrolladores [R=301,L]
  RewriteRule ^fr/blog/bonnes-pratiques-combinees-pour-applications-web-modernes-securite-cache-et-websocket/?$ /fr/blog/cookies-cache-et-websockets-un-guide-pratique-pour-les-developpeurs [R=301,L]
  RewriteRule ^de/blog/kombinierte-best-practices-fur-moderne-web-apps-sicherheit-caching-und-websocket/?$ /de/blog/cookies-cache-und-websockets-ein-praktischer-leitfaden-fur-entwickler [R=301,L]
  RewriteRule ^blog/case-study-crisi-indicizzazione-seo-angular-produzione/?$ /blog/perche-il-blog-non-viene-indicizzato-da-google [R=301,L]
  RewriteRule ^en/blog/how-i-diagnosed-and-fixed-an-seo-indexing-crisis-in-production-a-case-study/?$ /en/blog/why-my-angular-blog-isnt-indexed-by-google-and-how-i-fixed-it [R=301,L]
  RewriteRule ^sq/blog/si-e-diagnostikova-dhe-e-zgjidha-nje-krize-indeksimi-seo-ne-prodhim-rast-studimi/?$ /sq/blog/pse-blogu-im-angular-nuk-eshte-i-indeksuar-nga-google-dhe-si-e-rregullova [R=301,L]
  RewriteRule ^pt/blog/como-diagnostiquei-e-resolvi-uma-crise-de-indexacao-seo-em-producao-estudo-de-caso/?$ /pt/blog/por-que-meu-blog-angular-nao-e-indexado-pelo-google-e-como-corrigi-isso [R=301,L]
  RewriteRule ^es/blog/como-diagnostique-y-resolvi-una-crisis-de-indexacion-seo-en-produccion-caso-practico/?$ /es/blog/por-que-google-no-indexa-mi-blog-de-angular-y-como-lo-solucione [R=301,L]
  RewriteRule ^fr/blog/comment-jai-diagnostique-et-resolu-une-crise-dindexation-seo-en-production-etude-de-cas/?$ /fr/blog/pourquoi-mon-blog-angulaire-nest-pas-indexe-par-google-et-comment-je-lai-corrige [R=301,L]
  RewriteRule ^de/blog/wie-ich-eine-seo-indexierungskrise-in-produktion-diagnostiziert-und-gelost-habe-eine-fallstudie/?$ /de/blog/warum-mein-angular-blog-nicht-von-google-indiziert-wird-und-wie-ich-das-problem-behoben-habe [R=301,L]

  # Serve the build-time prerendered homepage for the exact root request,
  # keeping the URL as / (canonical) instead of redirecting to /homepage.
  RewriteRule ^$ homepage/index.html [L]

  # Serve prerendered directory pages (projects/, blog/, blog/<slug>/,
  # contact/, dashboard/*) directly on their no-trailing-slash URL instead
  # of letting the request fall through as a directory listing/redirect.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # Generic CSR shell for routes with no prerendered index.html of their own.
  # Angular names this index.csr.html instead of index.html once
  # SSR/prerendering is active, specifically so hosts don't serve this empty
  # shell in place of a real prerendered page at /.
  # Solo per le rotte dell'app che davvero non hanno una pagina prerenderizzata
  # (con o senza prefisso lingua): area admin e login, ricerca, I miei file,
  # link della newsletter, e articoli/progetti pubblicati dopo l'ultimo build.
  # Per questi ultimi solo il frontend sa se lo slug esiste: se no, noindex.
  RewriteRule ^(?:(?:en|sq|es|pt|fr|de)/)?(?:dashboard|search|newsletter|blog|projects|lab/i-miei-file)(?:/.*)?$ index.csr.html [L]

  # /en, /de/ ...: home prerenderizzata della lingua (come / con homepage/).
  RewriteRule ^(en|sq|es|pt|fr|de)/?$ $1/homepage/index.html [L]

  # Tutto il resto non esiste: 404 vero. Prima era 200 con la shell, e il
  # router rimandava alla home (soft 404 per Google). L'ErrorDocument è la
  # stessa shell: l'app mostra la pagina "non trovata" con i link utili.
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /index.csr.html

# Brotli first: when the client advertises `br`, Apache prefers this filter
# over mod_deflate's gzip below and skips it. Browsers that only send
# `gzip` fall through to mod_deflate untouched, so this is purely additive
# — roughly 15-20% smaller than gzip on the prerendered HTML (~33KB gzip
# for the homepage) and on the JS/CSS bundles.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/x-font-woff application/x-font-ttf image/svg+xml
</IfModule>

# ── Serving the pre-compressed files the rewrite rules above select ──
# Without these the browser receives Brotli bytes labelled as plain
# JavaScript and fails to parse them.
<IfModule mod_mime.c>
  # Declare the real media type for each double extension, so the .br/.gz
  # suffix doesn't erase the Content-Type the browser needs.
  AddType application/javascript      .js.br .js.gz .mjs.br .mjs.gz
  AddType text/css                    .css.br .css.gz
  AddType text/html                   .html.br .html.gz
  AddType application/json            .json.br .json.gz .webmanifest.br .webmanifest.gz
  AddType image/svg+xml               .svg.br .svg.gz
  AddType application/xml             .xml.br .xml.gz
  AddType text/plain                  .txt.br .txt.gz
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.br$">
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
    # Already compressed — stop mod_deflate from gzipping the Brotli payload.
    SetEnv no-gzip 1
  </FilesMatch>

  <FilesMatch "\.gz$">
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
    SetEnv no-gzip 1
  </FilesMatch>

  # La politica di cache sotto ragiona sul nome reale del file: la ripeto per i
  # gemelli pre-compressi (.br/.gz). Stesso ordine: prima la regola generica
  # (file senza hash), poi l'immutable solo per i file con hash di build.
  <FilesMatch "\.(js|mjs|css|json|svg|webmanifest)\.(br|gz)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  <FilesMatch "^[A-Za-z0-9_.]+-[A-Z0-9]{8}\.(js|mjs|css)\.(br|gz)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^index\.(html|csr\.html)\.(br|gz)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # Cache "immutable" di un anno SOLO per i file il cui nome contiene l'hash di
  # build di Angular (main-XXXXXXXX.js, chunk-XXXXXXXX.js, styles-XXXXXXXX.css):
  # cambiano nome a ogni modifica, quindi non possono restare vecchi.
  # Tutto il resto ha un nome stabile e può cambiare restando allo stesso URL:
  # le traduzioni /i18n/*.json, pdf.worker.min.mjs (deve restare della stessa
  # versione di pdfjs-dist, altrimenti "API version does not match Worker
  # version" per chi ha il file in cache), ngsw-worker.js, immagini, icone,
  # manifest. Con immutable un deploy non raggiungeva i visitatori di ritorno
  # per un anno intero: qui scade in un giorno e poi si rivalida con l'ETag
  # (304, nessun corpo scaricato di nuovo se non è cambiato).
  <FilesMatch "\.(js|mjs|css|json|svg|png|jpg|jpeg|webp|avif|woff|woff2|webmanifest)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  <FilesMatch "^[A-Za-z0-9_.]+-[A-Z0-9]{8}\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Il service worker e il suo manifest di versioni non vanno mai tenuti in cache.
  <FilesMatch "^(ngsw-worker\.js|ngsw\.json|safety-worker\.js)(\.(br|gz))?$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  <FilesMatch "^(index\.html|index\.csr\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Force HTTPS for 1 year on this domain too (API already sets this via
  # helmet, but that only covers API responses — the actual pages served
  # statically here had no HSTS at all before this).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Disable browser features not used anywhere in the app.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Scoped to the actual external origins this site loads. Every font is now
  # self-hosted under /assets/fonts — Inter and JetBrains Mono joined the
  # icon faces there — so fonts.googleapis.com and fonts.gstatic.com are no
  # longer in style-src/font-src. GA4 (gtag.js + beacons) and the Railway API
  # are the only third parties left.
  # unsafe-inline on script/style is required for GA4's inline bootstrap
  # snippet and Angular Material's runtime style injection — narrowing that
  # further would need a nonce/hash pipeline this static deploy doesn't have.
  # frame-src blob: is required for the PDF tools' <iframe [src]="blobUrl">
  # previews (pdf-translate, convert). Verify in a browser (DevTools console
  # shows CSP violations) after deploying, especially the PDF tool pages and
  # that text still renders in Inter rather than a system fallback.
  # archive.org + *.archive.org (its download links 302-redirect to a
  # per-item storage subdomain, e.g. dn710203.ca.archive.org) are needed for
  # the PDF Search tool's <iframe [src]="externalPdfUrl"> preview. The Railway
  # backend origin is also needed there: Project Gutenberg books are rendered
  # to PDF on the fly by our own API (no PDF format exists on gutenberg.org
  # itself), so that preview loads from portfolio-backend-*, not archive.org.
  # arxiv.org is the third PDF Search source — serves its own PDFs directly.
  #
  # connect-src elenca il backend Railway DUE volte, con schemi diversi:
  # https:// per le chiamate REST + il transport polling di Socket.IO, e wss://
  # per il WebSocket della chat live. Non è una ridondanza: la CSP confronta
  # anche lo schema, quindi `https://host` NON autorizza `wss://host` — senza la
  # riga wss:// il browser blocca il socket con una violazione connect-src e la
  # chat live resta bloccata su "Connessione in corso" per sempre.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' wss://gentsallaku.it https://*.google-analytics.com https://*.analytics.google.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://ipwho.is; frame-src 'self' blob: https://archive.org https://*.archive.org https://arxiv.org https://challenges.cloudflare.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>