<IfModule mod_dir.c>
  # Prevent Apache's automatic trailing-slash redirect for directory
  # requests (e.g. /projects -> /projects/) — it fires before mod_rewrite's
  # own directory handling below and would 301 every prerendered route
  # away from its own canonical (no-trailing-slash) URL.
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Pre-compressed assets ────────────────────────────────────
  # This server has no mod_brotli (requesting `Accept-Encoding: br` alone
  # returns an uncompressed response), and a FileZilla deploy can't enable
  # server modules. scripts/precompress.js therefore emits <file>.br and
  # <file>.gz at build time — at quality 11 / level 9, which would be far too
  # slow to run per request but is free once on the build machine — and these
  # rules hand them out when the client advertises support.
  # Must stay above the SPA fallback rules below, which end in [L].
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}\.br -f
  RewriteRule ^(.+)$ $1.br [L]

  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}\.gz -f
  RewriteRule ^(.+)$ $1.gz [L]

  # AI/PDF tool pages moved from /dashboard/* to /lab/* (2026-08) — permanent
  # redirects so existing bookmarks/search results keep working instead of
  # 404ing, and so the old URLs' indexing transfers to the new ones instead
  # of being lost. Must come before the SPA fallback rules below.
  RewriteRule ^dashboard/tools/?$ /lab [R=301,L]
  RewriteRule ^dashboard/(pdf-summary|ai-formatter|pdf-translate|ai-ppt|convert|pdf-editor|viewer|editor|ocr|scanner)(/.*)?$ /lab/$1$2 [R=301,L]

  # Serve the build-time prerendered homepage for the exact root request,
  # keeping the URL as / (canonical) instead of redirecting to /homepage.
  RewriteRule ^$ homepage/index.html [L]

  # Serve prerendered directory pages (projects/, blog/, blog/<slug>/,
  # contact/, dashboard/*) directly on their no-trailing-slash URL instead
  # of letting the request fall through as a directory listing/redirect.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# Brotli first: when the client advertises `br`, Apache prefers this filter
# over mod_deflate's gzip below and skips it. Browsers that only send
# `gzip` fall through to mod_deflate untouched, so this is purely additive
# — roughly 15-20% smaller than gzip on the prerendered HTML (~33KB gzip
# for the homepage) and on the JS/CSS bundles.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/x-font-woff application/x-font-ttf image/svg+xml
</IfModule>

# ── Serving the pre-compressed files the rewrite rules above select ──
# Without these the browser receives Brotli bytes labelled as plain
# JavaScript and fails to parse them.
<IfModule mod_mime.c>
  # Declare the real media type for each double extension, so the .br/.gz
  # suffix doesn't erase the Content-Type the browser needs.
  AddType application/javascript      .js.br .js.gz .mjs.br .mjs.gz
  AddType text/css                    .css.br .css.gz
  AddType text/html                   .html.br .html.gz
  AddType application/json            .json.br .json.gz .webmanifest.br .webmanifest.gz
  AddType image/svg+xml               .svg.br .svg.gz
  AddType application/xml             .xml.br .xml.gz
  AddType text/plain                  .txt.br .txt.gz
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.br$">
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
    # Already compressed — stop mod_deflate from gzipping the Brotli payload.
    SetEnv no-gzip 1
  </FilesMatch>

  <FilesMatch "\.gz$">
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
    SetEnv no-gzip 1
  </FilesMatch>

  # The hashed-filename cache policy below matches on the real extension, so
  # repeat it for the pre-compressed twins of those same immutable assets.
  <FilesMatch "\.(js|mjs|css|json|svg)\.(br|gz)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^index\.html\.(br|gz)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|json|svg|png|jpg|jpeg|webp|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Force HTTPS for 1 year on this domain too (API already sets this via
  # helmet, but that only covers API responses — the actual pages served
  # statically here had no HSTS at all before this).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Disable browser features not used anywhere in the app.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Scoped to the actual external origins this site loads. Every font is now
  # self-hosted under /assets/fonts — Inter and JetBrains Mono joined the
  # icon faces there — so fonts.googleapis.com and fonts.gstatic.com are no
  # longer in style-src/font-src. GA4 (gtag.js + beacons) and the Railway API
  # are the only third parties left.
  # unsafe-inline on script/style is required for GA4's inline bootstrap
  # snippet and Angular Material's runtime style injection — narrowing that
  # further would need a nonce/hash pipeline this static deploy doesn't have.
  # frame-src blob: is required for the PDF tools' <iframe [src]="blobUrl">
  # previews (pdf-translate, convert). Verify in a browser (DevTools console
  # shows CSP violations) after deploying, especially the PDF tool pages and
  # that text still renders in Inter rather than a system fallback.
  # archive.org + *.archive.org (its download links 302-redirect to a
  # per-item storage subdomain, e.g. dn710203.ca.archive.org) are needed for
  # the PDF Search tool's <iframe [src]="externalPdfUrl"> preview. The Railway
  # backend origin is also needed there: Project Gutenberg books are rendered
  # to PDF on the fly by our own API (no PDF format exists on gutenberg.org
  # itself), so that preview loads from portfolio-backend-*, not archive.org.
  # arxiv.org is the third PDF Search source — serves its own PDFs directly.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://portfolio-backend-production-e76d.up.railway.app https://*.google-analytics.com https://www.googletagmanager.com; frame-src 'self' blob: https://archive.org https://*.archive.org https://arxiv.org https://portfolio-backend-production-e76d.up.railway.app; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>