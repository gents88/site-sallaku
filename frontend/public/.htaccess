<IfModule mod_dir.c>
  # Prevent Apache's automatic trailing-slash redirect for directory
  # requests (e.g. /projects -> /projects/) — it fires before mod_rewrite's
  # own directory handling below and would 301 every prerendered route
  # away from its own canonical (no-trailing-slash) URL.
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve the build-time prerendered homepage for the exact root request,
  # keeping the URL as / (canonical) instead of redirecting to /homepage.
  RewriteRule ^$ homepage/index.html [L]

  # Serve prerendered directory pages (projects/, blog/, blog/<slug>/,
  # contact/, dashboard/*) directly on their no-trailing-slash URL instead
  # of letting the request fall through as a directory listing/redirect.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/x-font-woff application/x-font-ttf
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|json|svg|png|jpg|jpeg|webp|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Force HTTPS for 1 year on this domain too (API already sets this via
  # helmet, but that only covers API responses — the actual pages served
  # statically here had no HSTS at all before this).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Disable browser features not used anywhere in the app.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Scoped to the actual external origins this site loads: Google Fonts,
  # Font Awesome (jsdelivr), GA4 (gtag.js + beacons), the Railway API.
  # unsafe-inline on script/style is required for GA4's inline bootstrap
  # snippet and Angular Material's runtime style injection — narrowing that
  # further would need a nonce/hash pipeline this static deploy doesn't have.
  # frame-src blob: is required for the PDF tools' <iframe [src]="blobUrl">
  # previews (pdf-translate, convert). Verify in a browser (DevTools console
  # shows CSP violations) after deploying, especially the PDF tool pages.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; img-src 'self' data: blob: https:; connect-src 'self' https://portfolio-backend-production-e76d.up.railway.app https://*.google-analytics.com https://www.googletagmanager.com; frame-src 'self' blob:; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>