{
  "name": "portfolio-frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node ../scripts/generate-sitemap.js && node ../scripts/copy-vendor-css.js && node ../scripts/prefetch-blog-posts.js",
    "prebuild:prod": "npm run prebuild",
    "prebuild:filezilla": "npm run prebuild",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:filezilla": "ng build --configuration production && node -e \"const fs=require('fs'),d='dist/portfolio-frontend/browser';if(!fs.existsSync(d+'/index.html')&&fs.existsSync(d+'/index.csr.html'))fs.renameSync(d+'/index.csr.html',d+'/index.html')\" && node ../scripts/precompress.js dist/portfolio-frontend/browser",
    "deploy:prep": "ng build --configuration production",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/service-worker": "^22.2.1",
    "@angular/ssr": "^22.2.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@sentry/angular": "^10.70.0",
    "dompurify": "^3.4.14",
    "driver.js": "^1.9.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.52.0",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/prismjs": "^1.26.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10"
  }
}
