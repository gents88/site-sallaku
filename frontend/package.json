{
  "name": "portfolio-frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node ../scripts/generate-sitemap.js",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:filezilla": "ng build --configuration production && node -e \"const fs=require('fs'),d='dist/portfolio-frontend/browser';if(!fs.existsSync(d+'/index.html')&&fs.existsSync(d+'/index.csr.html'))fs.renameSync(d+'/index.csr.html',d+'/index.html')\"",
    "deploy:prep": "ng build --configuration production",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^21.2.19",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-server": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@angular/service-worker": "^21.2.19",
    "@angular/ssr": "^21.2.19",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@sentry/angular": "^10.70.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@playwright/test": "^1.52.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/prismjs": "^1.26.6",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10"
  }
}
