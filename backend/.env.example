# ── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development   # development | staging | production

# ── MongoDB ──────────────────────────────────────────
# Usa il nome DB corrispondente all'ambiente:
#   sviluppo → portfolio_dev
#   UAT      → portfolio_uat
#   produzione → portfolio_prod
MONGODB_URI=mongodb://localhost:27017/portfolio_dev

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# ── Admin bootstrap ──────────────────────────────────
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@yourportfolio.com
ADMIN_PASSWORD=ChangeMe123!

# ── Email (Nodemailer / Gmail App-Password) ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Portfolio Contact <your-email@gmail.com>"
EMAIL_TO=admin@yourportfolio.com
FRONTEND_URL=https://yourportfolio.com

# ── CORS ─────────────────────────────────────────────
CORS_ORIGIN=https://yourportfolio.com,https://your-frontend.up.railway.app

# ── Google Search Console (opzionale) ────────────────
# Lascia vuoti per disabilitare il widget SEO nel dashboard
# 1. Crea un Service Account su Google Cloud Console
# 2. Scarica la chiave JSON e usa email + private_key
# 3. Aggiungi l'email del service account come utente in Search Console
GSC_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GSC_SITE_URL=https://yourportfolio.com

# ── Analytics data retention (GDPR storage limitation) ─
# Raw page_views/click_events documents auto-expire after this many days
# (MongoDB TTL index). Aggregated stats are unaffected. Match your privacy policy.
ANALYTICS_RETENTION_DAYS=400

# ── Error tracking (opzionale) ───────────────────────
# Lascia vuoto per disabilitare Sentry (no-op).
SENTRY_DSN=

# ── Cache (opzionale) ─────────────────────────────────
# Lascia vuoto per usare la cache in-memory di default (ok su singola istanza).
# Impostala per condividere la cache tra più istanze / sopravvivere ai redeploy.
REDIS_URL=

# ── Live Chat Handoff ─────────────────────────────────
# Minuti entro cui Gent deve entrare in chat prima che la richiesta scada
LIVE_HANDOFF_TIMEOUT_MINUTES=15
# Numero massimo di richieste di chat live accettate al giorno (anti-spam)
LIVE_HANDOFF_MAX_PER_DAY=20
# Dopo quante ore una chat live aperta e mai chiusa viene chiusa d'ufficio
# (evita che resti "attiva" per sempre nella card della dashboard)
LIVE_HANDOFF_SESSION_MAX_HOURS=2

# ── AI provider (Groq) ────────────────────────────────
GROQ_API_KEY=

# ── Quota giornaliera AI (/ai/*, chatbot) ─────────────
# Difesa anti-abuso oltre al rate limit al minuto: gli endpoint /ai/* sono
# anonimi, quindi il solo @Throttle per-IP non ferma un abuso sostenuto nel
# tempo (IP rotation, o un drip lento per tutto il giorno).
# Budget totale di token (prompt+completion) al giorno: superato, gli
# endpoint /ai/* rispondono 503 per tutti finché non scatta la mezzanotte
# (kill switch sui costi, indipendente dal numero di IP coinvolti).
AI_DAILY_TOKEN_BUDGET=300000
# Richieste massime al giorno per singolo IP (hashato, non salvato in chiaro)
# su tutti gli endpoint /ai/* insieme. Superato, risponde 429.
AI_MAX_CALLS_PER_IP_PER_DAY=30

# ── Cloudflare Turnstile (opzionale) ─────────────────
# Lascia vuoto per disabilitare la verifica anti-bot sui form pubblici
# (contact, notes, testimonials) — restano comunque protetti da honeypot +
# rate limiting. Chiavi da dash.cloudflare.com/turnstile (sito + secret key,
# la site key pubblica va invece nel frontend, environment.ts).
TURNSTILE_SECRET_KEY=
