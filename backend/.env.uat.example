# ── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=staging

# ── MongoDB ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/portfolio_uat

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# ── Admin bootstrap ──────────────────────────────────
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@yourportfolio.com
ADMIN_PASSWORD=ChangeMe123!

# ── Email (Nodemailer / Gmail App-Password) ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Portfolio Contact <your-email@gmail.com>"
EMAIL_TO=admin@yourportfolio.com
FRONTEND_URL=https://yourportfolio.com
# URL pubblico dell'API (link one-click List-Unsubscribe delle campagne newsletter)
PUBLIC_API_URL=https://portfolio-backend-uat.up.railway.app/api/v1

# ── CORS ─────────────────────────────────────────────
CORS_ORIGIN=https://yourportfolio.com,https://your-frontend.up.railway.app

# ── Google Search Console (opzionale) ────────────────
# Lascia vuoti per disabilitare il widget SEO nel dashboard
# 1. Crea un Service Account su Google Cloud Console
# 2. Scarica la chiave JSON e usa email + private_key
# 3. Aggiungi l'email del service account come utente in Search Console
GSC_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GSC_SITE_URL=https://yourportfolio.com

# ── Error tracking (opzionale) ───────────────────────
SENTRY_DSN=

# ── Cache (opzionale) ─────────────────────────────────
REDIS_URL=

# ── Cloudflare Turnstile (opzionale) ─────────────────
TURNSTILE_SECRET_KEY=

# Refresh token in cookie httpOnly invece che nel JSON/localStorage.
# Attivare SOLO se API e frontend stanno sullo stesso sito (es. api.gentsallaku.it
# + gentsallaku.it), insieme a environment.authRefreshCookie=true nel frontend:
# con l'API su *.up.railway.app il cookie sarebbe di terze parti e Safari lo blocca.
AUTH_REFRESH_COOKIE=false
# strict (default) | lax | none (none richiede HTTPS)
AUTH_COOKIE_SAMESITE=strict
# Opzionale, es. .gentsallaku.it per condividerlo fra sottodomini
AUTH_COOKIE_DOMAIN=
