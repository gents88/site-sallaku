<div class="card" style="display:inline-block;vertical-align:top;width:140px;margin:4px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:14px 8px;text-align:center;box-sizing:border-box;">
  <div style="font-size:20px;line-height:1;margin-bottom:6px;">{{icon}}</div>
  <div style="font-size:26px;font-weight:700;color:{{color}};line-height:1;">{{value}}</div>
  <div class="muted" style="font-size:11px;color:#64748b;margin-top:5px;text-transform:uppercase;letter-spacing:0.05em;">{{label}}</div>
  {{#if trend}}
  <div style="font-size:12px;font-weight:600;margin-top:7px;white-space:nowrap;color:{{trend.vsYesterday.color}};">{{trend.vsYesterday.label}} <span class="muted" style="font-weight:400;color:#64748b;">su ieri</span></div>
  <div class="muted" style="font-size:11px;color:#64748b;margin-top:2px;white-space:nowrap;">media 7 gg: {{trend.avg7}} <span style="color:{{trend.vsAvg.color}};font-weight:600;">{{trend.vsAvg.label}}</span></div>
  {{/if}}
</div>
