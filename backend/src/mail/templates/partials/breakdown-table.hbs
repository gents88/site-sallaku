<div class="card" style="display:inline-block;vertical-align:top;width:100%;max-width:300px;margin:6px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;box-sizing:border-box;text-align:left;">
  <div style="background:{{accent}}1a;padding:10px 14px;border-bottom:1px solid {{accent}}33;">
    <span style="color:{{accent}};font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;">{{icon}} {{title}}</span>
  </div>
  <table role="presentation" width="100%" style="width:100%;border-collapse:collapse;">
    {{#each rows}}
    <tr>
      <td class="tx" style="padding:7px 8px 7px 14px;color:#0f172a;font-size:13px;word-break:break-word;">{{label}}</td>
      <td style="padding:7px 14px 7px 0;width:38%;">
        <table role="presentation" width="100%" style="width:100%;border-collapse:collapse;">
          <tr>
            <td style="vertical-align:middle;">
              <div style="background:{{../accent}}26;border-radius:3px;height:6px;">
                <div style="background:{{../accent}};height:6px;border-radius:3px;width:{{barWidth}}%;font-size:0;line-height:0;">&nbsp;</div>
              </div>
            </td>
            <td class="muted" style="vertical-align:middle;width:42px;text-align:right;color:#64748b;font-size:12px;padding-left:6px;">{{count}}</td>
          </tr>
        </table>
      </td>
    </tr>
    {{else}}
    <tr><td class="muted" style="padding:12px 14px;color:#94a3b8;font-size:13px;text-align:center;">{{emptyText}}</td></tr>
    {{/each}}
  </table>
</div>
