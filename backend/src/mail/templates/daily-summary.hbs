<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>Riepilogo giornaliero</title>
<style>
  /* Tema scuro per i client che lo supportano (Apple Mail, Gmail app): senza, i client scelgono da soli come invertire. */
  @media (prefers-color-scheme: dark) {
    .page { background: #0b1020 !important; }
    .wrap { background: #0b1020 !important; }
    .card { background: #131a2e !important; border-color: #2a3350 !important; }
    .tx { color: #e2e8f0 !important; }
    .muted { color: #94a3b8 !important; }
    .rule { border-color: #2a3350 !important; }
    .todo { background: #1b1830 !important; border-color: #3b3566 !important; }
    .clear { background: #0f2a22 !important; border-color: #14532d !important; }
  }
  @media only screen and (max-width: 480px) {
    .pad { padding-left: 12px !important; padding-right: 12px !important; }
    .hide-sm { display: none !important; }
  }
</style>
</head>
<body class="page" style="margin:0;padding:0;background:#f1f5f9;">
<div class="page" style="background:#f1f5f9;padding:16px 8px;">
<div class="wrap" style="font-family:Inter,-apple-system,'Segoe UI',Roboto,sans-serif;max-width:640px;margin:0 auto;background:#f1f5f9;color:#0f172a;">

  <!-- Intestazione: fondo pieno e testo bianco (non dipende dalla modalità scura del client) -->
  <div bgcolor="#1e1b4b" style="background:#1e1b4b;border-radius:14px 14px 0 0;padding:26px 28px;">
    <div style="color:#c7d2fe;font-size:12px;text-transform:uppercase;letter-spacing:0.1em;">&lt;GS /&gt; · Report automatico</div>
    <h1 style="color:#ffffff;margin:6px 0 2px;font-size:22px;line-height:1.25;">📊 Riepilogo giornaliero</h1>
    <div style="color:#a5b4fc;font-size:14px;">{{date}}</div>
    <div style="margin-top:14px;">
      <a href="{{dashboardUrl}}" style="display:inline-block;background:#6366f1;color:#ffffff;text-decoration:none;font-weight:600;font-size:14px;padding:10px 18px;border-radius:10px;">Apri la dashboard →</a>
    </div>
  </div>

  <div class="pad" style="padding:22px 20px 8px;">

    <!-- Da fare domani -->
    {{#if todo.length}}
    <div class="todo" style="background:#fffbeb;border:1px solid #fcd34d;border-radius:12px;padding:14px 16px;margin-bottom:20px;">
      <div class="tx" style="font-size:15px;font-weight:700;color:#0f172a;margin-bottom:8px;">⚡ Da fare domani</div>
      <table role="presentation" width="100%" style="width:100%;border-collapse:collapse;">
        {{#each todo}}
        <tr>
          <td style="padding:5px 0;font-size:14px;vertical-align:top;width:26px;">{{icon}}</td>
          <td class="tx" style="padding:5px 0;font-size:14px;color:#0f172a;">
            <a href="{{url}}" style="color:{{color}};text-decoration:none;"><strong>{{count}}</strong> {{label}}</a>
          </td>
        </tr>
        {{/each}}
      </table>
    </div>
    {{else}}
    <div class="clear" style="background:#f0fdf4;border:1px solid #86efac;border-radius:12px;padding:12px 16px;margin-bottom:20px;font-size:14px;color:#166534;">
      ✅ Tutto a posto: niente da fare per domani.
    </div>
    {{/if}}

    <!-- KPI con confronto -->
    <div style="font-size:0;text-align:center;margin-bottom:14px;">
      {{#each kpiRows}}{{#each this}}{{> stat-card}}{{/each}}{{/each}}
    </div>

    <!-- Pagine più viste -->
    <div class="card" style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;margin:6px 4px 14px;">
      <div style="background:#eef2ff;padding:10px 14px;border-bottom:1px solid #c7d2fe;">
        <span style="color:#4338ca;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;">📄 Pagine più viste oggi</span>
      </div>
      <table role="presentation" width="100%" style="width:100%;border-collapse:collapse;font-size:13px;">
        <thead>
          <tr>
            <th class="muted" style="padding:8px 14px;text-align:left;color:#64748b;font-size:11px;font-weight:600;">Pagina</th>
            <th class="muted" style="padding:8px 6px;text-align:right;color:#64748b;font-size:11px;font-weight:600;">Viste</th>
            <th class="muted hide-sm" style="padding:8px 6px;text-align:right;color:#64748b;font-size:11px;font-weight:600;">Unici</th>
            <th class="muted" style="padding:8px 14px 8px 6px;text-align:right;color:#64748b;font-size:11px;font-weight:600;">Tempo</th>
          </tr>
        </thead>
        <tbody>
          {{#each pages}}
          <tr>
            <td class="tx rule" style="padding:8px 14px;color:#0f172a;word-break:break-all;border-top:1px solid #f1f5f9;">
              {{path}}
              <div style="background:#e0e7ff;border-radius:3px;height:4px;margin-top:5px;"><div style="background:#6366f1;height:4px;border-radius:3px;width:{{barWidth}}%;font-size:0;line-height:0;">&nbsp;</div></div>
            </td>
            <td class="tx rule" style="padding:8px 6px;text-align:right;color:#4338ca;font-weight:700;border-top:1px solid #f1f5f9;">{{views}}</td>
            <td class="muted rule hide-sm" style="padding:8px 6px;text-align:right;color:#64748b;border-top:1px solid #f1f5f9;">{{uniqueVisitors}}</td>
            <td class="muted rule" style="padding:8px 14px 8px 6px;text-align:right;color:#64748b;white-space:nowrap;border-top:1px solid #f1f5f9;">{{avgTime}}</td>
          </tr>
          {{else}}
          <tr><td colspan="4" class="muted" style="padding:14px;color:#94a3b8;text-align:center;">Nessuna visita oggi</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    {{#if gsc}}
    <!-- Search Console (ultimi 28 giorni) -->
    <div class="card" style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;margin:6px 4px 14px;">
      <div style="background:#ecfdf5;padding:10px 14px;border-bottom:1px solid #a7f3d0;">
        <span style="color:#047857;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;">🔎 Google Search Console · ultimi 28 giorni</span>
      </div>
      <div class="tx" style="padding:12px 14px;font-size:14px;color:#0f172a;">
        <strong>{{gsc.clicks}}</strong> clic · <strong>{{gsc.impressions}}</strong> impressioni · CTR <strong>{{gsc.ctr}}</strong> · posizione media <strong>{{gsc.position}}</strong>
      </div>
      {{#if gsc.queries.length}}
      <table role="presentation" width="100%" style="width:100%;border-collapse:collapse;font-size:13px;">
        {{#each gsc.queries}}
        <tr>
          <td class="tx rule" style="padding:7px 14px;color:#0f172a;border-top:1px solid #f1f5f9;word-break:break-word;">{{query}}</td>
          <td class="muted rule" style="padding:7px 8px;text-align:right;color:#64748b;border-top:1px solid #f1f5f9;white-space:nowrap;">{{clicks}} clic</td>
          <td class="muted rule" style="padding:7px 14px 7px 8px;text-align:right;color:#64748b;border-top:1px solid #f1f5f9;white-space:nowrap;">pos. {{position}}</td>
        </tr>
        {{/each}}
      </table>
      {{/if}}
    </div>
    {{/if}}

    {{#if chat}}
    <div class="card" style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;margin:6px 4px 14px;">
      <div style="background:#ecfdf5;padding:10px 14px;border-bottom:1px solid #a7f3d0;">
        <span style="color:#047857;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;">🤖 Chatbot oggi</span>
      </div>
      <div class="tx" style="padding:12px 14px 6px;font-size:14px;color:#0f172a;">
        <strong>{{chat.questionsCount}}</strong> domande in <strong>{{chat.sessions}}</strong> conversazioni · <strong>{{chat.fallbackReplies}}</strong> risposte predefinite
        <span class="muted" style="color:#64748b;font-size:12px;">(l'AI non ha risposto)</span>
      </div>
      {{#each chat.questions}}
      <div class="tx rule" style="padding:7px 14px;font-size:13px;color:#0f172a;border-top:1px solid #f1f5f9;">“{{this}}”</div>
      {{/each}}
    </div>
    {{/if}}

    {{#if system.length}}
    <div class="card" style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;margin:6px 4px 14px;">
      <div style="background:#f1f5f9;padding:10px 14px;border-bottom:1px solid #e2e8f0;">
        <span style="color:#334155;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;">🩺 Stato del sistema</span>
      </div>
      <table role="presentation" width="100%" style="width:100%;border-collapse:collapse;font-size:13px;">
        {{#each system}}
        <tr>
          <td class="muted rule" style="padding:8px 14px;color:#64748b;border-top:1px solid #f1f5f9;">{{dot}} {{label}}</td>
          <td class="rule" style="padding:8px 14px;text-align:right;font-weight:600;color:{{color}};border-top:1px solid #f1f5f9;">{{value}}</td>
        </tr>
        {{/each}}
      </table>
    </div>
    {{/if}}

    <!-- Tabelle di dettaglio: due per riga su schermo largo, una per riga sul telefono -->
    {{#each tablePairs}}
    <div style="font-size:0;text-align:center;">
      {{> breakdown-table left}}{{> breakdown-table right}}
    </div>
    {{/each}}

    <!-- Messaggi di contatto -->
    <div class="card" style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;margin:6px 4px 14px;">
      <div style="background:#fffbeb;padding:10px 14px;border-bottom:1px solid #fde68a;">
        <span style="color:#b45309;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;">✉️ Messaggi di contatto oggi ({{contacts.length}})</span>
      </div>
      {{#each contacts}}
      <div class="rule" style="padding:10px 14px;border-top:1px solid #f1f5f9;">
        <div class="tx" style="font-size:14px;color:#0f172a;"><strong>{{name}}</strong> <span class="muted" style="color:#64748b;font-size:12px;">· {{time}} · {{email}}</span></div>
        <div class="muted" style="font-size:13px;color:#64748b;margin-top:3px;">{{preview}}</div>
      </div>
      {{else}}
      <div class="muted" style="padding:14px;color:#94a3b8;text-align:center;font-size:13px;">Nessun messaggio oggi</div>
      {{/each}}
    </div>

  </div>

  <div class="muted" style="padding:6px 20px 18px;text-align:center;font-size:12px;color:#64748b;">
    Report automatico delle 22:00 · <a href="{{dashboardUrl}}" style="color:#6366f1;">Apri la dashboard</a> · © {{year}} Gent Sallaku
  </div>
</div>
</div>
</body>
</html>
